# ============================================
# ChatPDF 环境配置文件
# 复制此文件为 .env 并修改相应配置
# ============================================

# --------------------------------------------
# DeepSeek API 配置（必需）
# 获取 API Key: https://platform.deepseek.com/
# --------------------------------------------
DEEPSEEK_API_KEY=sk-your-api-key-here

# --------------------------------------------
# 数据库配置
# 开发阶段使用 SQLite，生产环境可改为 PostgreSQL
# 示例 PostgreSQL: postgresql+asyncpg://user:password@localhost/chatpdf
# --------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./chatpdf.db

# --------------------------------------------
# JWT 认证配置
# 生产环境务必修改 JWT_SECRET_KEY 为随机强密码
# --------------------------------------------
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --------------------------------------------
# 应用基础配置
# --------------------------------------------
DEBUG=true
APP_NAME=ChatPDF

# --------------------------------------------
# CORS 跨域配置（逗号分隔）
# 根据前端实际地址配置，开发环境保持默认即可
# --------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --------------------------------------------
# 文件上传配置
# MAX_FILE_SIZE: 最大文件大小（字节），默认 50MB
# --------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
