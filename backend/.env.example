# ============================================
# ChatPDF 环境配置文件
# 复制此文件为 .env 并修改相应配置
# ============================================

# --------------------------------------------
# DeepSeek API 配置（必需）
# 获取 API Key: https://platform.deepseek.com/
# --------------------------------------------
DEEPSEEK_API_KEY=sk-your-api-key-here

# --------------------------------------------
# 数据库配置
# 开发阶段使用 SQLite，生产环境可改为 PostgreSQL
# 示例 PostgreSQL: postgresql+asyncpg://user:password@localhost/chatpdf
# --------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./chatpdf.db

# --------------------------------------------
# JWT 认证配置
# 生产环境务必修改 JWT_SECRET_KEY 为随机强密码
# --------------------------------------------
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --------------------------------------------
# 应用基础配置
# --------------------------------------------
DEBUG=true
APP_NAME=ChatPDF

# --------------------------------------------
# CORS 跨域配置（逗号分隔）
# 根据前端实际地址配置，开发环境保持默认即可
# --------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --------------------------------------------
# 文件上传配置
# MAX_FILE_SIZE: 最大文件大小（字节），默认 50MB
# --------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# --------------------------------------------
# 联网搜索 API Key 配置（可选，至少配一个即可使用联网搜索）
# 若所有 Key 均未配置，系统将仅使用百度搜索（网页抓取模式，无需 Key）
# --------------------------------------------
# Bing Web Search API: https://portal.azure.com/#view/Microsoft_Azure_ProjectOxford/CognitiveServicesHub/~/BingSearch
# BING_SEARCH_API_KEY=
# Tavily AI Search API: https://tavily.com/
# TAVILY_API_KEY=
# Brave Search API: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=

# --------------------------------------------
# 学术 MCP 服务配置（可选）
# 以下服务均有免费额度，首次启动时系统会自动启用 arxiv/crossref/dblp
# --------------------------------------------
# Semantic Scholar API Key（可选，有免费额度）
# S2_API_KEY=
# CrossRef 邮箱（推荐配置，否则可能被限流）
# CROSSREF_MAILTO=your-email@example.com
# Zotero API Key（用于同步引用到 Zotero）
# ZOTERO_API_KEY=

# --------------------------------------------
# RAG 增强检索配置（可选）
# --------------------------------------------
# Reranker 重排序，默认开启，关闭可提升速度降低内存
RAG_RERANKER_ENABLED=true
# Reranker 模型（使用 BAAI/bge-reranker-v2-m3，首次使用需下载约 2GB）
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Reranker 保留 Top-K 结果
RAG_RERANKER_TOP_K=5
# HyDE 查询扩展（默认关闭，开启会增加 500-1000ms 延迟）
RAG_HYDE_ENABLED=false

# --------------------------------------------
# 智能路由与成本控制（可选）
# --------------------------------------------
# 模型路由模式: local_only | smart_route | cloud_only
MODEL_ROUTE_MODE=smart_route
# 月度预算上限（元）
MODEL_BUDGET_LIMIT=10.0
# 单次费用确认阈值（元，超过此值需用户确认）
MODEL_CONFIRM_THRESHOLD=0.5

# --------------------------------------------
# 预缓存配置（可选）
# --------------------------------------------
# 启用 arXiv 论文预缓存（默认关闭）
PRECACHE_ENABLED=false
# 预缓存检查间隔（小时）
PRECACHE_INTERVAL_HOURS=1
# 预缓存有效期（小时）
PRECACHE_TTL_HOURS=24
# 默认关注领域（arXiv 分类标签，逗号分隔）
PRECACHE_DEFAULT_TOPICS=cs.AI,cs.CL,cs.CV

# --------------------------------------------
# 图片处理配置
# --------------------------------------------
MAX_IMAGE_SIZE_MB=10
IMAGE_CACHE_ENABLED=true
